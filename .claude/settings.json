{
  "permissions": {
    "allow": [
      "Bash(bash *.claude/skills/unsplash-image-finder/unsplash-search.sh*)",
      "Bash(bash *.claude/skills/unsplash-image-finder/unsplash-track.sh*)",
      "Bash(bash *.claude/skills/unsplash-image-finder/unsplash-health-check.sh*)",
      "Bash(bash *.claude/skills/one-page-site-builder/brand-icon.sh*)",
      "Bash(npx wrangler dev:*)",
      "Bash(npx wrangler types:*)",
      "Bash(npx wrangler d1 migrations apply * --local:*)",
      "Bash(npx wrangler d1 migrations create:*)",
      "Bash(npx wrangler d1 execute * --local:*)",
      "Bash(npm install)",
      "Bash(npm run dev:*)",
      "Bash(npm run types:*)",
      "Bash(npm run check:*)",
      "Bash(npm run db:migrate:local:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-worker-name.sh\""
          }
        ]
      }
    ]
  }
}
